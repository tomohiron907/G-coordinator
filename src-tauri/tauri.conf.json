{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-coordinator",
  "identifier": "com.gcoordinator.app",
  "version": "3.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "G-coordinator",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/settings/settings.json": "settings/settings.json",
      "../src/settings/start_gcode.txt": "settings/start_gcode.txt",
      "../src/settings/end_gcode.txt": "settings/end_gcode.txt",
      "../src/resources/FiraCode-Regular.ttf": "resources/FiraCode-Regular.ttf"
    },
    "externalBin": [
      "binaries/runner",
      "binaries/gcode-gen",
      "binaries/completion-data"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "72Y2MB92H5",
      "signingIdentity": "Developer ID Application: Tomohiro TANIGUCHI (72Y2MB92H5)"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
